ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
TTS_CACHE_DIR=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_GUARD_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=Cura

GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_STT_PROMPT=

# Required by /api/journal. Without both, getSupabase() returns null and the
# journal silently stops persisting. The service role key bypasses RLS, so it is
# server-only — never expose it via NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
